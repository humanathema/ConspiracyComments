# data: too large + privacy (usernames in derived files); share aggregates deliberately
# NOTE: must be data/* not data/ -- git cannot re-include a file via `!` if a
# parent directory is itself excluded (found 2026-08-20 the hard way).
data/*
# exceptions: small, no-PII structured logs meant to be git-tracked ground truth
# (found 2026-08-20: these were silently un-committed the whole project because
# of the blanket data/ ignore above -- defeats their whole purpose)
!data/experiment_log.jsonl
!data/infra_map.jsonl
!data/session_registry.jsonl
# secrets
key.pem
*.pem
.gemini_key
.geminikey
.gemini*key*
.freekey
.deepseekkey
*.key
# environments & caches
.venv/
__pycache__/
.ipynb_checkpoints/
.virtual_documents/
.DS_Store
.tmp/
repomix-output*.xml
# local corpus index (18GB, built by build_local_context_db.py -- never commit this)
local_context.duckdb
# local posts index (825MB, built by hitl_rater.py's _get_posts_con() -- never commit this)
local_posts_index.duckdb
# model checkpoints, inference outputs (large binaries, not source) -- never commit this
outputs/
# archived notebook history stays on disk, out of the repo
notebooks/archive/
notebooks/scratchpads/
scratch/
*.backup.ipynb
*.ipynb.bak
.secrets/
*.log
.gcloudpncc
